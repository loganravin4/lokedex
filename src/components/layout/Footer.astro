    path: 'M1.5 4.5h21v15h-21v-15zm1.9 1.9v.3l8.6 5.4 8.6-5.4v-.3H3.4zm17.2 11.2V9.1l-8.6 5.4-8.6-5.4v8.5h17.2z',
