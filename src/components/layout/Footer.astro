---

<footer class="mt-20 border-t-[3px] border-ink bg-paper-2">
  <!-- speaker grille: the device's bottom chrome -->
  <div class="h-3 w-full bg-ink" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 py-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
    <div>
      <p class="font-display text-sm tracking-[0.12em] text-ink mb-2">LOKÉDEX</p>
      <p class="font-data text-sm text-ink-soft max-w-md leading-relaxed">
        Logan Ravinuthala — Honors Computer Engineering &amp; Computer Science,
        Northeastern University.
      </p>
    </div>

    <!-- Segmented action row: every control is labelled, no bare glyphs -->
    <nav aria-label="Contact and profiles" class="w-full md:w-auto">
      <ul class="grid grid-cols-3 border-[3px] border-ink list-none p-0 m-0 md:min-w-[22rem]">
        {actions.map((a, i) => (
          <li class:list={[i < actions.length - 1 && 'border-r-[3px] border-ink']}>
            <a
              href={a.href}
              target={a.external ? '_blank' : undefined}
              rel={a.external ? 'noopener noreferrer' : undefined}
              data-track-external={a.track}
              class="flex flex-col items-center justify-center gap-1.5 px-3 py-3.5 bg-paper text-ink hover:bg-dex-yellow h-full"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={a.path} />
              </svg>
              <span class="font-display text-[0.5rem] tracking-[0.15em]">{a.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t-[3px] border-ink">
    <div class="mx-auto max-w-7xl px-4 py-3">
      <p class="font-data text-xs text-ink-soft">
        © {year} Logan Ravinuthala · Built with Astro
      </p>
    </div>
  </div>
</footer>
