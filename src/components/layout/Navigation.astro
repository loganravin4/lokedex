---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-paper-2 border-b-[3px] border-ink"
  aria-label="Main"
>
  <div class="mx-auto max-w-7xl px-4 h-[4.5rem] md:h-20 flex items-center gap-4">

    <!-- Device chrome: the lens is the only round element on the site -->
    <a href="/" class="flex items-center gap-3 group shrink-0 min-h-11" aria-label="Lokédex home">
      <span class="relative block w-9 h-9 md:w-10 md:h-10 shrink-0">
        <span class="absolute inset-0 rounded-full bg-ink"></span>
        <span class="absolute inset-[3px] rounded-full bg-dex-blue"></span>
        <span class="absolute left-[7px] top-[6px] w-2.5 h-2.5 rounded-full bg-dex-blue-lit"></span>
        <span class="absolute left-[10px] top-[9px] w-1 h-1 rounded-full bg-paper/90"></span>
      </span>

      <span class="hidden sm:flex gap-1.5" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-lamp-red border-2 border-ink animate-lamp-blink"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-lamp-amber border-2 border-ink"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-lamp-green border-2 border-ink"></span>
      </span>

      <span class="font-display text-base md:text-lg tracking-[0.12em] text-ink">
        LOKÉDEX
      </span>
    </a>

    <div class="flex-1"></div>

    <!-- Desktop tabs -->
    <div class="hidden md:flex items-end gap-2">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'font-display text-xs tracking-wider px-4 py-2.5 pixel-box pixel-press',
            isActive(link.href)
              ? 'bg-dex-red text-paper'
              : 'bg-paper text-ink hover:bg-paper-3',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile: START button -->
    <button
      id="menu-toggle"
      class="md:hidden font-display text-[0.65rem] tracking-wider px-4 min-h-11 pixel-box pixel-press bg-paper text-ink"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-label">MENU</span>
    </button>
  </div>
</nav>

<!-- Mobile menu: a full LCD screen, like pausing the game -->
<div
  id="mobile-menu"
  class="hidden md:hidden fixed inset-0 z-40 bg-screen-0 crt pt-[4.5rem]"
>
  <div class="h-full overflow-y-auto px-5 py-8">
    <p class="font-display text-[0.6rem] tracking-[0.25em] text-screen-2 mb-6">
      SELECT A SCREEN
    </p>
    <ul class="flex flex-col gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-menu-link
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'group flex items-center gap-3 px-3 py-4 font-display text-sm tracking-wider',
              isActive(link.href) ? 'text-screen-3' : 'text-screen-2',
            ]}
          >
            <span
              class:list={[
                'w-3 shrink-0',
                isActive(link.href) ? 'opacity-100' : 'opacity-0 group-hover:opacity-100',
              ]}
              aria-hidden="true"
            >▶</span>
            {link.label.toUpperCase()}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  function initNav() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const label = document.getElementById('menu-label');
    if (!toggle || !menu || !label) return;

    // ClientRouter fires astro:page-load on first load too, so this runs twice
    // on a cold start. Without this guard we bind two click listeners and they
    // cancel each other out — the menu opens and instantly closes.
    if (toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'CLOSE' : 'MENU';
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
  // a nav swapped in by a view transition starts unbound
  document.addEventListener('astro:after-swap', () => {
    document.body.style.overflow = '';
  });
</script>
