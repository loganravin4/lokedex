---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import PostHogInit from '../components/analytics/PostHogInit';
import AnalyticsClickHandler from '../components/analytics/AnalyticsClickHandler';
import LayoutPageView from '../components/analytics/LayoutPageView';
import ClarityInit from '../components/analytics/ClarityInit';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The Lokédex - A Pokémon-themed developer portfolio" } = Astro.props;

const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#C6272B" />

    <!-- Type: Silkscreen (chrome) / IBM Plex Sans (body) / IBM Plex Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Set before first paint so the hidden reveal state never flashes -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    {posthogKey && <PostHogInit apiKey={posthogKey} apiHost={posthogHost} client:load />}
    {posthogKey && <LayoutPageView client:load />}
    {posthogKey && <AnalyticsClickHandler client:load />}
    <ClarityInit client:load />

    <a href="#main" class="skip-link">Skip to content</a>

    <Navigation />

    <div id="main" class="flex-1 pt-[4.5rem] md:pt-[5rem]">
      <slot />
    </div>

    <Footer />

    <script is:inline>
      (() => {
        /**
         * Reveals elements once, as they scroll into view.
         * Sweeps per frame during a scroll rather than using
         * IntersectionObserver, which a fast flick can outrun.
         */
        function armReveals() {
          let pending = Array.prototype.slice.call(
            document.querySelectorAll('.reveal-band:not(.is-in)')
          );
          if (!pending.length) return;

          let rafId = 0;
          let idle = 0;

          function teardown() {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
            if (rafId) cancelAnimationFrame(rafId);
            rafId = 0;
          }

          function sweep() {
            const limit = window.innerHeight * 0.92;
            pending = pending.filter((el) => {
              if (el.getBoundingClientRect().top < limit) {
                el.classList.add('is-in');
                return false;
              }
              return true;
            });
            if (!pending.length) teardown();
          }

          function pump() {
            sweep();
            if (!pending.length) return;
            if (++idle > 30) {
              rafId = 0;
              return;
            }
            rafId = requestAnimationFrame(pump);
          }

          function onScroll() {
            idle = 0;
            if (!rafId) rafId = requestAnimationFrame(pump);
          }

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });

          sweep();
          window.setTimeout(sweep, 1200);
        }

        armReveals();
        document.addEventListener('astro:page-load', armReveals);
      })();
    </script>

  </body>

</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  /* Battle transition: the new screen wipes in as six hard chunks. */
  @keyframes dex-wipe {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  ::view-transition-old(root) {
    animation: none;
  }
  ::view-transition-new(root) {
    animation: dex-wipe 380ms steps(6, end) both;
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }
  }
</style>
