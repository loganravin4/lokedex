---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/ui/Panel.astro';
import AnalyticsTracker from '../components/analytics/AnalyticsTracker';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

const fields = [
  { id: 'name', label: 'TRAINER NAME', type: 'text', placeholder: 'Your name' },
  { id: 'email', label: 'LINK ADDRESS', type: 'email', placeholder: 'your.email@example.com' },
  { id: 'subject', label: 'SUBJECT', type: 'text', placeholder: "What's this about?" },
];

const inputClass =
  'w-full px-3 py-3.5 bg-paper border-[3px] border-ink text-ink font-data text-base ' +
  'placeholder:text-ink-soft/60 focus:outline-none focus:border-dex-blue focus:bg-dex-yellow/15';
---

<BaseLayout title="Contact - Logan's Lokédex">
  <AnalyticsTracker pageName="Contact" client:load />

  <main class="mx-auto max-w-3xl px-4 py-8 md:py-12 flex flex-col gap-10">
    <Panel title="TRADE REQUEST" eyebrow="LINK CABLE READY" tone="yellow">
      <p class="text-sm text-ink-soft mb-5">
        Interested in working together? Open a link and send a message.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-paper-2 text-ink hover:bg-paper-3"
      >
        <span aria-hidden="true">&#9666;</span>
        BACK TO HOME
      </a>
    </Panel>

    <section class="pixel-lift bg-paper">
      <div class="flex items-center gap-3 px-4 py-3 bg-ink border-b-[3px] border-ink">
        <span class="w-2.5 h-2.5 rounded-full bg-lamp-green border-2 border-paper/70 animate-lamp-blink" aria-hidden="true"></span>
        <h2 class="font-display text-[0.7rem] tracking-[0.15em] text-dex-yellow">
          CONNECTION ESTABLISHED
        </h2>
      </div>

      <div class="p-5 md:p-7">
        <!-- Success readout (hidden by default) -->
        <div id="success-message" class="hidden">
          <div class="bg-ink p-2 mb-5">
            <div class="bg-screen-0 px-4 py-6 text-center">
              <p class="font-display text-[0.7rem] tracking-[0.15em] text-screen-3 mb-3">
                TRADE COMPLETE
              </p>
              <p class="font-data text-sm text-screen-2">
                Thanks for reaching out! I'll get back to you as soon as possible.
              </p>
            </div>
          </div>
          <button
            id="reset-form-btn"
            type="button"
            class="w-full font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-dex-yellow text-ink hover:bg-dex-yellow-deep cursor-pointer"
          >
            SEND ANOTHER MESSAGE
          </button>
        </div>

        <!-- Error readout (hidden by default) -->
        <div id="error-message" class="hidden mb-5 border-[3px] border-ink bg-dex-red px-4 py-3">
          <p class="font-data text-sm text-paper">
            Something went wrong. Try again, or email me directly at loganravin4@gmail.com.
          </p>
        </div>

        <form id="contact-form" class="flex flex-col gap-5">
          <input type="hidden" name="access_key" value={accessKey} />

          <!-- Honeypot: hidden from people, tempting to bots -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            style="position: absolute; left: -9999px;"
            aria-hidden="true"
          />

          {fields.map((f) => (
            <div>
              <label
                for={f.id}
                class="block font-display text-[0.55rem] tracking-[0.18em] text-ink-soft mb-2"
              >
                {f.label} <span class="text-dex-red">*</span>
              </label>
              <input
                type={f.type}
                id={f.id}
                name={f.id}
                required
                placeholder={f.placeholder}
                class={inputClass}
              />
            </div>
          ))}

          <div>
            <label
              for="message"
              class="block font-display text-[0.55rem] tracking-[0.18em] text-ink-soft mb-2"
            >
              MESSAGE <span class="text-dex-red">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Tell me more..."
              class={`${inputClass} resize-y`}
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full flex items-center justify-center gap-2 font-display text-[0.7rem] tracking-wider px-5 py-4 pixel-box pixel-press bg-dex-red text-paper hover:bg-dex-red-deep disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer"
          >
            <span id="submit-text">SEND TRADE REQUEST</span>
            <span id="submit-loading" class="hidden">CONNECTING&hellip;</span>
          </button>
        </form>

        <!-- Direct line -->
        <div class="mt-7 pt-6 border-t-[3px] border-ink">
          <p class="font-display text-[0.55rem] tracking-[0.18em] text-ink-soft mb-3">
            OR REACH OUT DIRECTLY
          </p>
          <a
            href="mailto:loganravin4@gmail.com"
            class="inline-flex items-center min-h-11 py-2 font-data text-base text-dex-blue underline underline-offset-2 decoration-2 hover:bg-dex-blue hover:text-paper"
          >
            loganravin4@gmail.com
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initContactForm } from '../lib/contactForm';

  const boot = () => initContactForm();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
