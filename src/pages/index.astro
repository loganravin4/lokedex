---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/ui/Panel.astro';
import TypeChip from '../components/ui/TypeChip.astro';
import PokedexCard from '../components/projects/PokedexCard';
import DexEntry from '../components/features/DexEntry';
import SpotifyWidget from '../components/features/SpotifyWidget';
import AnalyticsTracker from '../components/analytics/AnalyticsTracker';
import { fetchFeaturedProjects } from '../lib/fetchProjects';

// Fetch featured projects from Sanity
const projects = await fetchFeaturedProjects();

// Transform Sanity data to match component props
const transformedProjects = projects.map((project) => ({
  id: project._id,
  name: project.name,
  description: project.description,
  shortDescription: project.shortDescription,
  types: project.types,
  techs: project.techs,
  link: project.link,
  github: project.github,
}));

const techStack = [
  { type: 'electric', tech: 'TypeScript' },
  { type: 'water', tech: 'React' },
  { type: 'fire', tech: 'Node.js' },
  { type: 'grass', tech: 'Python' },
  { type: 'psychic', tech: 'SQL' },
  { type: 'dragon', tech: 'Java' },
  { type: 'steel', tech: 'C/C++' },
  { type: 'ghost', tech: 'AWS' },
  { type: 'fairy', tech: 'Docker' },
  { type: 'ice', tech: 'Astro' },
  { type: 'fighting', tech: 'Git' },
  { type: 'rock', tech: 'Linux' },
];

const titles = [
  'Full-Stack Developer',
  'Backend Engineer',
  'Software Engineer',
  'Technical Lead',
  'Embedded Software Engineer',
  'AI Engineer',
  'Data Engineer',
  'Pokémon Trainer',
  'Mario Kart Speedrunner',
  "The Weeknd's Biggest Fan",
  'BTS Army',
  'Gym Rat',
  'Cheese Pizza Lover',
  'Technical Problem Solver',
  'GOAT',
  'Karaoke Machine',
  'Project-Based Learner',
  'Nintendo Fanatic',
  'Your Next Partner',
];
---

<BaseLayout title="Logan's Lokédex - Gotta Code 'Em All!">
  <AnalyticsTracker pageName="Home" client:load />

  <main class="mx-auto max-w-6xl px-4 py-8 md:py-12 flex flex-col gap-14 md:gap-20">
    <!-- Hero: the signature Pokédex entry screen -->
    <DexEntry titles={titles} client:load />

    <!-- Welcome -->
    <Panel title="WELCOME" eyebrow="README" tone="ink">
      <p class="text-base md:text-lg leading-relaxed text-ink">
        Welcome to the <span class="font-display text-sm text-dex-red">LOKÉDEX</span>.
        Get it? My name is <strong class="font-semibold">Logan</strong>, I love
        <strong class="font-semibold">Pokémon</strong>, and this is my take on the
        <strong class="font-semibold text-dex-red">Pokédex</strong>: a collection of projects,
        experiences, and skills I've caught and trained. Gotta code 'em all!
      </p>
    </Panel>

    <!-- Tech stack: static chips, zero JS -->
    <Panel
      title="TYPE EFFECTIVENESS"
      eyebrow={`${techStack.length} CAUGHT`}
      id="skills"
    >
      <p class="text-sm text-ink-soft mb-6">Technologies I've caught and trained.</p>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {techStack.map((item) => (
          <li>
            <TypeChip type={item.type} tech={item.tech} />
          </li>
        ))}
      </ul>
    </Panel>

    <!-- Projects -->
    <Panel
      title="PROJECT LOKÉDEX"
      eyebrow={`${transformedProjects.length} ENTRIES`}
      id="projects"
    >
      <p class="text-sm text-ink-soft mb-7">The Elite Four of my portfolio.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {transformedProjects.map((project, index) => (
          <PokedexCard project={project} index={index} client:visible />
        ))}
      </div>

      <div class="mt-7">
        <a
          href="/projects"
          class="inline-block font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-paper-2 text-ink hover:bg-paper-3"
        >
          SEE COMPLETE LOKÉDEX
        </a>
      </div>
    </Panel>

    <!-- About -->
    <Panel title="ABOUT THE TRAINER" eyebrow="BIO" id="about" tone="blue">
      <div class="max-w-[68ch] flex flex-col gap-4 text-ink leading-relaxed">
        <p>
          Hey! I'm Logan, an Honors Computer Engineering and Computer Science student at
          Northeastern University.
        </p>
        <p>
          I'm an incoming Software Engineer Co-op at MORSE Corp, where I'll be contributing to the
          best-in-class technical solutions for difficult multidisciplinary problems in the U.S.
          national security ecosystem. I'm also a Member of Technical Staff at CampusGTM, a
          Full-stack AI SaaS for campus ambassador programs.
        </p>
        <p>
          I've previously worked as a Software Engineer at NExT Consulting, both as a co-op and
          part-time. I contributed to building innovative software solutions for external clients,
          including an AI Chief-of-Staff and a data analytics platform. I also served as a Teaching
          Assistant for Introduction to Databases (CS3200) and Fundamentals of Computer Science
          (CS2500).
        </p>
        <p>
          On campus, I serve as a Software Engineer at Generate Product Development Studio and the
          Head of Digital Innovation at the Student Government Association.
        </p>
        <p>
          When I'm not coding, you'll find me weightlifting, going on long walks with no
          destination, gaming on Mario Kart or Pokémon, or vibing with my 76,533 minutes on Spotify
          (will almost ALWAYS be either The Weeknd or BTS).
        </p>
      </div>

      <!-- Now playing -->
      <div class="mt-8">
        <SpotifyWidget client:visible />
      </div>

      <!-- Education -->
      <div class="mt-8 pt-7 border-t-[3px] border-ink">
        <h3 class="font-display text-[0.7rem] tracking-[0.2em] text-ink-soft mb-4">EDUCATION</h3>
        <div class="bg-paper-2 border-[3px] border-ink p-4">
          <p class="font-display text-xs text-ink mb-2">NORTHEASTERN UNIVERSITY</p>
          <p class="font-data text-sm text-ink-soft">
            BSCmpE Computer Engineering &amp; Computer Science (Honors)
          </p>
          <p class="font-data text-sm text-ink-soft">GPA: 3.9/4.0</p>
        </div>
      </div>

      <!-- Socials -->
      <div class="flex flex-wrap gap-3 mt-8">
        <a
          href="https://github.com/loganravin4"
          target="_blank"
          rel="noopener noreferrer"
          data-track-external="github"
          class="inline-flex items-center gap-2 font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-ink text-paper hover:bg-dex-blue"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GITHUB
        </a>

        <a
          href="https://www.linkedin.com/in/logan-ravinuthala/"
          target="_blank"
          rel="noopener noreferrer"
          data-track-external="linkedin"
          class="inline-flex items-center gap-2 font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-dex-blue text-paper hover:bg-ink"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LINKEDIN
        </a>
      </div>
    </Panel>

    <!-- New grad timeline -->
    <Panel title="NEW GRAD TIMELINE" eyebrow="STATUS: OPEN" id="new-grad">
      <div class="bg-ink p-2">
        <p class="bg-screen-0 px-4 py-4 font-data text-sm md:text-base text-screen-3 leading-relaxed">
          <span class="text-screen-2" aria-hidden="true">&gt;</span> I graduate in
          <span data-graduation-countdown class="font-semibold">loading...</span>
          (<span data-graduation-days class="font-semibold">--</span> days total).
          I am actively exploring New Grad software engineering opportunities for when I graduate.
        </p>
      </div>
    </Panel>
  </main>
</BaseLayout>

<script>
  const graduationDate = new Date('2027-05-02T00:00:00-04:00');

  const toWholeDays = (milliseconds: number) => Math.ceil(milliseconds / (1000 * 60 * 60 * 24));

  const formatCountdown = (milliseconds: number) => {
    const totalDays = toWholeDays(milliseconds);
    const totalMonths = Math.floor(totalDays / 30.44);
    const remainingDays = Math.max(0, Math.round(totalDays - totalMonths * 30.44));

    if (totalMonths <= 0) {
      return `${totalDays} day${totalDays === 1 ? '' : 's'}`;
    }

    return `${totalMonths} month${totalMonths === 1 ? '' : 's'} and ${remainingDays} day${remainingDays === 1 ? '' : 's'}`;
  };

  const updateGraduationCountdown = () => {
    const countdownEls = document.querySelectorAll<HTMLSpanElement>('[data-graduation-countdown]');
    const daysEls = document.querySelectorAll<HTMLSpanElement>('[data-graduation-days]');
    if (countdownEls.length === 0 || daysEls.length === 0) return;

    const now = new Date();
    const diff = graduationDate.getTime() - now.getTime();

    if (diff <= 0) {
      countdownEls.forEach((el) => {
        el.textContent = 'graduated!';
      });
      daysEls.forEach((el) => {
        el.textContent = '0';
      });
      return;
    }

    const days = String(toWholeDays(diff));
    const countdown = formatCountdown(diff);
    countdownEls.forEach((el) => {
      el.textContent = countdown;
    });
    daysEls.forEach((el) => {
      el.textContent = days;
    });
  };

  let timer: number | undefined;

  const start = () => {
    updateGraduationCountdown();
    window.clearInterval(timer);
    timer = window.setInterval(updateGraduationCountdown, 60_000);
    // the hero types its countdown in after the boot sequence
    window.setTimeout(updateGraduationCountdown, 1200);
  };

  start();
  document.addEventListener('astro:page-load', start);
</script>
