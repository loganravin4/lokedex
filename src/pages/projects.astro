---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/ui/Panel.astro';
import ProjectFilter from '../components/projects/ProjectFilter';
import AnalyticsTracker from '../components/analytics/AnalyticsTracker';
import { fetchProjects } from '../lib/fetchProjects';

// Fetch ALL projects from Sanity
const projects = await fetchProjects();

// Transform Sanity data
const transformedProjects = projects.map((project) => ({
  id: project._id,
  name: project.name,
  description: project.description,
  types: project.types,
  techs: project.techs,
  link: project.link,
  github: project.github,
}));
---

<BaseLayout title="Complete Lokédex - Logan's Portfolio">
  <AnalyticsTracker pageName="Projects" client:load />

  <main class="mx-auto max-w-6xl px-4 py-8 md:py-12 flex flex-col gap-10">
    <Panel title="COMPLETE LOKÉDEX" eyebrow={`${projects.length} ENTRIES`} tone="yellow">
      <p class="text-sm text-ink-soft mb-5">
        Every project I've caught and trained. Filter by type below.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 font-display text-[0.65rem] tracking-wider px-5 py-3.5 pixel-box pixel-press bg-paper-2 text-ink hover:bg-paper-3"
      >
        <span aria-hidden="true">&#9666;</span>
        BACK TO HOME
      </a>
    </Panel>

    <ProjectFilter projects={transformedProjects} client:load />
  </main>
</BaseLayout>
